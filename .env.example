# Copy to .env and fill in. .env is ignored by git.

# The key every client must send. Generate one with: openssl rand -hex 24
API_KEY=change-me

# Where the GGUF files go (about 84 GB): IQ3_S/ with two shards, plus the vision projector.
MODELS_DIR=/srv/models/qwen38-flash-next
# XeStrata's state: its pack (1.5 GB), the MTP draft layer (6.5 GB), logs and the generated config.
STATE_DIR=/srv/xestrata

# The address the API listens on. 127.0.0.1 is this machine only. To reach it from other machines, use a private
# address (a LAN or VPN interface), never a public one.
BIND_ADDR=127.0.0.1
PORT=8000

# The model name /v1/models reports. Clients may send any name.
SERVED_NAME=qwen38

# Everything below is optional. The defaults are the measured configuration; docs/settings.md says why.
# Quote a value that contains spaces with single quotes: the scripts source this file as shell.
# MAX_CONTEXT=262144
# SAMPLING='{"temperature": 1.0, "top_p": 0.95, "top_k": 20}'
# VRAM_RESERVE_MIB=2048
# RESIDENT_EXPERTS=1
# CONVERSATION_CACHE_MIB=8192
# CONVERSATION_CACHE_SLOTS=4
# PCIE_FRAC=0.75
# SPEC_MIN_P=0.70
# VISION_MAX_TOKENS=1024
# VISION_THREADS=
# VISION_GPU=0
# ENGINE_ARGS=
